{
  "compilerOptions": {
    "target": "ES2018",
    "module": "commonjs",
    "jsx": "react-jsx",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",

    "moduleResolution": "node",
    "resolveJsonModule": true,

    "rootDir": ".",
    "outDir": "./dist"
  },

  "include": ["src", "render.ts", "run-render.ts"],
  "exclude": ["node_modules", "dist"]
}